# ============================================
# CineList — Environment Variables Template
# ============================================
# Copy this file to .env and fill with real values.
# NEVER commit the .env file itself.

# ---------------------------------------------
# TMDB API (https://www.themoviedb.org/settings/api)
# ---------------------------------------------

# API Key (v3 auth, 32 chars) — required
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Access Token (v4 JWT auth, Bearer) — required
VITE_TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# TMDB API base URL
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB image URLs
VITE_TMDB_IMAGE_URL=https://image.tmdb.org/t/p/w500
VITE_TMDB_IMAGE_ORIGINAL=https://image.tmdb.org/t/p/original